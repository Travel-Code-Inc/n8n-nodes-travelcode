{
  "name": "n8n-nodes-travelcode",
  "version": "0.2.0",
  "description": "n8n nodes for Travel Code: corporate travel bookings, expenses, approvals and invoices",
  "license": "MIT",
  "homepage": "https://travel-code.com",
  "keywords": [
    "n8n-community-node-package",
    "travel",
    "travelcode",
    "corporate-travel",
    "expenses",
    "approvals",
    "flights",
    "hotels"
  ],
  "author": {
    "name": "Travel Code Inc.",
    "email": "help@travel-code.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Travel-Code-Inc/n8n-nodes-travelcode.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/TravelCodeOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TravelCode/TravelCode.node.js",
      "dist/nodes/TravelCodeTrigger/TravelCodeTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.15"
  }
}
